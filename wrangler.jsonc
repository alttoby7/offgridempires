{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "offgridempire",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "offgridempire"
    }
  ],
  // Enable R2 caching after activating R2 in Cloudflare Dashboard:
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "offgridempire-cache"
  //   }
  // ]
  "account_id": "4e99280ddad67e4382b367daccf6c5e0",
  "routes": [
    { "pattern": "offgridempire.com/*", "zone_name": "offgridempire.com" },
    { "pattern": "www.offgridempire.com/*", "zone_name": "offgridempire.com" }
  ]
}
